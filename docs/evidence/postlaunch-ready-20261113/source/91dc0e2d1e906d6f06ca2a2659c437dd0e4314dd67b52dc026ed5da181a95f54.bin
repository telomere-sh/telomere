[Unit]
Description=Telomere public canonical Selection index (read-only chain access)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telomere-selection-review
Group=telomere-selection-review
EnvironmentFile=/etc/telomere-selection-public.env
ExecStart=/opt/node-v22.23.3-linux-x64/bin/node /opt/telomere-mainnet-pilot/selection-public/current/dist/scripts/selection-public-service.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telomere-selection-public
MemoryMax=768M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=multi-user.target

.dashboard-page .tl-header{background:var(--paper);border-bottom:1px solid var(--line);height:78px}.dashboard-page .header-workspace{display:none}.dashboard-page #page-content{padding-top:78px}.console{padding:0 3.5vw;max-width:1800px;margin:auto}.console-mast{display:flex;justify-content:space-between;align-items:center;padding:27px 0}.console-device{font-size:9px;color:var(--muted)}.console-device:first-letter{color:var(--orange)}.console-nav{border-bottom:1px solid var(--line);display:flex;gap:32px;overflow:auto;scrollbar-width:none}.console-nav button{border:0;background:none;white-space:nowrap;color:var(--muted);padding:15px 0 20px;position:relative;font-size:13px}.console-nav button.active{color:var(--ink)}.console-nav button.active:after{content:'';position:absolute;height:2px;bottom:0;left:0;right:0;background:var(--orange)}.console-nav button:hover{color:var(--orange)}.console-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;padding:47px 0 35px}.console-heading h1{font-size:clamp(40px,5.1vw,79px);font-weight:400;letter-spacing:-.055em;line-height:1.01;margin:18px 0}.console-heading p{font-size:14px;line-height:1.5;color:var(--muted);margin:0}.console-heading .pill{font-size:12px;min-height:44px;white-space:nowrap;margin-bottom:5px}.console-heading .mono{font-size:9px;letter-spacing:1.1px}.console-metrics{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:28px 0;margin:0 0 32px}.console-metric{padding:0 27px;border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:start}.console-metric:first-child{padding-left:0}.console-metric:last-child{border-right:0}.console-metric .mono{font-size:9px}.console-metric strong{font-size:48px;letter-spacing:-2px;font-weight:400;line-height:1.1;margin:13px 0 10px}.console-metric>span{color:var(--muted);font-size:11px}.console-main-grid{display:grid;grid-template-columns:minmax(0,2.25fr) minmax(260px,1fr);gap:25px}.usage-chart{padding:25px 28px 20px;border:1px solid var(--line);position:relative}.usage-chart:before,.console-object:before{content:'';position:absolute;top:-1px;left:-1px;width:15px;height:15px;border-left:2px solid var(--orange);border-top:2px solid var(--orange)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:13px}.panel-head .mono{font-size:8px;letter-spacing:.5px}.panel-head h2{font-size:15px;font-weight:500;margin:0}.chart-number{font-size:38px;font-weight:400;letter-spacing:-1.5px;margin:30px 0 0}.chart-number span{font:10px ui-monospace;color:var(--muted);letter-spacing:.5px;margin-left:8px}.usage-chart>svg{width:100%;height:auto;display:block}.chart-caption{display:flex;justify-content:space-between;color:var(--muted);font-size:10px}.chart-caption i{width:6px;height:6px;display:inline-block;background:var(--orange);margin-right:7px}.budget-panel{padding:25px 28px;border:1px solid var(--line);background:#e7e5e04d;display:flex;flex-direction:column}.budget-panel .panel-head{margin-bottom:34px}.budget-panel>.mono{font-size:8px}.budget-number{font-size:54px;font-weight:400;letter-spacing:-2.5px;display:flex;align-items:baseline;gap:8px;margin:13px 0 25px}.budget-number span{font:9px ui-monospace;letter-spacing:.5px;color:var(--muted)}.budget-track{height:5px;background:var(--line)}.budget-track i{display:block;background:var(--orange);height:100%;transition:width .7s}.budget-numbers{display:flex;justify-content:space-between;font-size:9px;color:var(--muted);margin:12px 0 22px}.budget-panel p{font-size:12px;line-height:1.6;color:var(--muted);max-width:240px}.budget-panel .text-link{margin-top:auto;font-size:12px;display:flex;background:none;border:0;border-top:1px solid var(--line);width:100%}.console-section{margin:32px 0 0;border:1px solid var(--line)}.console-section>.panel-head{padding:22px 26px;border-bottom:1px solid var(--line)}.count{background:var(--panel);padding:3px 7px;font:10px ui-monospace;margin-left:10px}.quiet-button{border:0;background:none;font-size:11px;color:var(--muted);padding:6px 0}.quiet-button:hover{color:var(--orange)}.console-table-wrap{width:100%;overflow:auto}.console-table{border-collapse:collapse;width:100%;text-align:left;white-space:nowrap}.console-table th{font:8px ui-monospace;letter-spacing:.8px;color:var(--muted);padding:15px 25px;border-bottom:1px solid var(--line);background:#e7e5e044}.console-table td{padding:20px 25px;border-bottom:1px solid var(--line);font-size:12px}.console-table tr:last-child td{border-bottom:0}.console-table tr[data-open]{cursor:pointer}.console-table tr[data-open]:hover td{background:#e7e5e080}.console-table td small{display:block;font-size:9px;color:var(--muted);margin-top:6px}.table-workload{display:flex;align-items:center;gap:14px}.table-workload .icon{width:28px;height:28px;color:var(--orange)}.table-workload strong{font-size:12px;font-weight:500}.row-arrow{text-align:right;font-size:20px!important}.status{display:inline-flex;gap:6px;align-items:center;font-size:9px;background:#e1e0d9;padding:6px 9px;border-radius:3px;color:#494943;white-space:nowrap}.status i{height:4px;width:4px;background:var(--orange)}.status.blocked{background:#f2d9cc;color:#a44427}.status.neutral{background:#e1dfd9}.console-empty{padding:55px 25px 58px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:300px}.console-empty>.icon{height:39px;width:39px;margin-bottom:23px;color:var(--orange)}.console-empty h3{font-weight:400;font-size:25px;letter-spacing:-.7px;margin:0 0 10px}.console-empty p{font-size:12px;line-height:1.6;color:var(--muted);max-width:370px;margin:0 0 25px}.console-empty .pill{font-size:11px;min-height:38px;padding:10px 20px}.console-lower{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin:25px 0 50px}.primitive-panel{padding:30px;background:var(--ink);color:var(--paper)}.primitive-panel>.mono{font-size:9px;color:#a09e96}.primitive-panel h3{font-size:31px;font-weight:400;letter-spacing:-1px;line-height:1.1;margin:25px 0 30px}.primitive-panel p{color:#a09e96;font-size:13px;line-height:1.6;max-width:600px}.primitive-panel a{border-color:#4a4942;font-size:12px}.seconds-strip{display:flex;align-items:center;gap:5px;margin:10px 0 15px}.seconds-strip i{width:17px;height:26px;border-radius:16px;background:var(--orange);flex:0 0 17px}.seconds-strip b{display:block;flex:1;height:26px;background:var(--paper);border-radius:2px}.seconds-strip .unused{background:#5a5952}.strip-labels{display:flex;justify-content:space-between;color:#a19e97;font-size:8px;letter-spacing:.8px;margin-bottom:17px}.activity-panel{padding:30px;border:1px solid var(--line)}.activity-row{display:flex;align-items:center;gap:12px;padding:19px 0;border-bottom:1px solid var(--line)}.activity-dot{height:5px;width:5px;background:var(--orange)}.activity-row>div{flex:1}.activity-row strong{font-size:12px;font-weight:400}.activity-row small{font:9px ui-monospace;color:var(--muted);display:block;margin-top:7px}.activity-row>span:last-child{font-size:13px;color:var(--muted)}.activity-empty{font-size:13px;line-height:1.7;color:var(--muted);padding:48px 0 25px}.console-foot{border-top:1px solid var(--line);display:flex;justify-content:space-between;padding:25px 0 30px;font-size:8px;color:var(--muted)}.table-toolbar{display:flex;gap:15px;margin:20px 0}.table-toolbar input{flex:1;max-width:400px;border:1px solid var(--line);padding:12px 15px;background:transparent;min-width:120px;font-size:12px}.table-toolbar select{border:1px solid var(--line);padding:12px;background:transparent;font-size:12px}.table-toolbar .quiet-button{margin-left:auto}.console-object-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:10px 0 50px}.console-object{border:1px solid var(--line);padding:28px;position:relative}.console-object h2{font-size:27px;font-weight:400;letter-spacing:-1px;margin:30px 0 22px;overflow-wrap:anywhere}.console-object .icon{color:var(--orange);width:32px;height:32px}.console-object>p{font-size:13px;line-height:1.6;color:var(--muted)}.object-pair{border-top:1px solid var(--line);padding:16px 0;display:flex;justify-content:space-between;gap:20px;font-size:11px;line-height:1.5}.object-pair span{color:var(--muted)}.object-pair strong{font-weight:400;text-align:right;overflow-wrap:anywhere}.object-pair code{font-size:10px;overflow-wrap:anywhere;text-align:right}.object-actions{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding-top:22px}.object-actions button{border:0;background:none;padding:0;font-size:11px}.object-actions button:hover{color:var(--orange)}.object-actions button:disabled{color:var(--muted);cursor:default}.console-note{display:flex;align-items:center;gap:25px;border:1px solid var(--line);padding:25px;margin:25px 0 50px}.console-note .icon{flex-shrink:0;color:var(--orange)}.console-note p{font-size:12px;line-height:1.6;color:var(--muted);max-width:700px;flex:1}.console-note a{font-size:11px;white-space:nowrap}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin:10px 0 70px}.settings-grid .console-object h2{margin:0 0 30px}.settings-grid .field{margin:20px 0}.settings-grid .text-link{border:0;border-top:1px solid var(--line);width:100%;background:none;font-size:12px}.drawer-scrim{position:fixed;inset:0;background:#19191955;z-index:2000;backdrop-filter:blur(3px)}.console-drawer{position:fixed;top:0;right:0;width:540px;max-width:100vw;height:100dvh;background:var(--paper);z-index:2001;overflow-y:auto;box-shadow:-30px 0 70px #19191915;transform:translateX(100%);transition:transform .5s var(--ease)}.console-drawer.open{transform:none}.drawer-head{padding:30px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:start;position:sticky;top:0;background:var(--paper);z-index:3}.drawer-head .mono{font-size:8px}.drawer-head h2{font-size:32px;line-height:1.05;font-weight:400;letter-spacing:-1px;margin:14px 0 0}.drawer-close{border:1px solid var(--line);border-radius:50%;background:none;width:34px;height:34px;font-size:24px;font-weight:300}.drawer-form{padding:28px 30px;display:flex;flex-direction:column;gap:22px}.drawer-form h3{font-size:15px;font-weight:400;margin:5px 0 -5px}.drawer-form .form-row{gap:15px}.drawer-form .field>span{font-size:8px;letter-spacing:.4px;line-height:1.6}.drawer-form .field input,.drawer-form .field select{font-size:12px;padding:12px}.drawer-form .form-summary{padding:20px}.drawer-form .form-summary strong{font-size:25px;white-space:nowrap}.drawer-form .form-summary .mono{font-size:8px;max-width:70px;line-height:1.5}.form-help{font-size:11px;color:var(--muted);line-height:1.6;margin:0}.form-error{font-size:12px;color:#af3d20;line-height:1.6}.form-error:empty{display:none}.check-field{display:flex;gap:9px;align-items:center;font-size:12px}.check-field input{accent-color:var(--orange)}.drawer-intro{font-size:19px;letter-spacing:-.5px;line-height:1.4;margin:0}.drawer-form .code-block{font-size:11px;padding:20px;line-height:1.8;margin:0}.drawer-form .object-pair{margin-bottom:-15px}.drawer-form .pill{width:100%;font-size:12px;min-height:46px}.console-drawer[hidden],.drawer-scrim[hidden]{display:none!important}
@media(min-width:1600px){.console-main-grid{grid-template-columns:2.7fr 1fr}.console-heading h1{font-size:85px}.console-metric strong{font-size:55px}.usage-chart>svg{max-height:300px}}
@media(max-width:1000px){.console{padding:0 24px}.console-nav{gap:25px}.console-main-grid{grid-template-columns:1.8fr 1fr;gap:18px}.usage-chart,.budget-panel{padding:20px}.budget-number{font-size:40px}.budget-panel p{font-size:11px}.console-object-grid{grid-template-columns:repeat(2,1fr)}.console-metric{padding:0 20px}.console-metric strong{font-size:39px}.console-metric .mono{font-size:8px;letter-spacing:.5px}.console-heading h1{font-size:55px}.console-lower{gap:18px}.primitive-panel,.activity-panel{padding:25px}.primitive-panel h3{font-size:27px}.table-toolbar .quiet-button{font-size:9px}}
@media(max-width:700px){.console{padding:0 20px}.console-mast{padding:24px 0 16px}.console-mast .eyebrow{font-size:8px;letter-spacing:.5px}.console-device{display:none}.console-nav{gap:25px}.console-nav button{font-size:12px;padding-bottom:15px}.console-heading{padding:35px 0 25px;align-items:start;flex-direction:column;gap:25px}.console-heading h1{font-size:51px}.console-heading p{font-size:12px;max-width:340px}.console-heading .pill{min-height:39px;font-size:11px}.console-metrics{grid-template-columns:1fr 1fr;gap:25px 0;padding:22px 0}.console-metric{padding:0 20px}.console-metric:first-child,.console-metric:nth-child(3){padding-left:0}.console-metric:nth-child(2){border-right:0}.console-metric strong{font-size:39px}.console-metric>span{font-size:9px}.console-main-grid{grid-template-columns:1fr}.usage-chart{padding:20px 18px}.budget-panel{padding:25px}.budget-panel .panel-head{margin-bottom:25px}.budget-panel p{max-width:100%;margin-bottom:22px}.budget-number{font-size:47px;margin-bottom:20px}.console-lower{grid-template-columns:1fr}.primitive-panel h3{font-size:29px}.console-section>.panel-head{padding:20px}.console-empty{padding:40px 20px;min-height:280px}.console-empty h3{font-size:23px}.console-table th,.console-table td{padding:16px}.console-object-grid,.settings-grid{grid-template-columns:1fr}.console-object{padding:25px}.console-note{flex-wrap:wrap;gap:15px}.console-note p{min-width:200px}.console-note a{margin-left:40px}.table-toolbar{flex-wrap:wrap}.table-toolbar input{max-width:none;flex:1}.table-toolbar .quiet-button{margin-left:0}.console-foot{font-size:7px;letter-spacing:.5px}.drawer-head{padding:25px}.drawer-form{padding:25px}.drawer-form .form-row{grid-template-columns:1fr 1fr}.drawer-form .form-summary strong{font-size:22px}}

.console{font-family:Inter,Arial,sans-serif;font-feature-settings:"cv11","ss01";font-variant-numeric:tabular-nums}.console-heading h1,.console h2,.console h3,.drawer-head h2{font-family:"Inter Display",Inter,sans-serif}.console-heading h1{font-weight:500;letter-spacing:-.055em}.console-nav button{font-weight:500;font-size:13px;letter-spacing:-.2px}.console-metric strong,.chart-number,.budget-number{font-family:"Inter Display",Inter,sans-serif;font-weight:500}.console-table small{font-size:12px}.workspace-appbar{display:none}#workspace-more{background:var(--paper);border:1px solid var(--line);padding:24px;color:var(--ink);width:min(440px,calc(100vw - 24px));border-top:3px solid var(--orange)}#workspace-more::backdrop{background:#19191966;backdrop-filter:blur(6px)}#workspace-more>.panel-head{margin-bottom:20px}#workspace-more-close{border:0;background:none;font-size:28px;width:44px;height:44px}#workspace-more>button{display:flex;align-items:center;gap:18px;width:100%;padding:20px 0;background:none;border:0;border-bottom:1px solid var(--line);font-size:17px;text-align:left}#workspace-more>button>span:last-child{margin-left:auto}.console-empty>.icon{width:52px;height:52px;margin-bottom:22px}.console-object .panel-head>.icon{width:36px;height:36px}
@media(max-width:700px){.dashboard-page #page-content{padding-top:96px}.console{padding:16px 16px calc(110px + env(safe-area-inset-bottom));overflow-x:clip}.console-mast{margin-bottom:22px}.console-nav{display:none}.console-device{display:none}.console-heading{padding-top:16px;gap:24px}.console-heading h1{font-size:48px;line-height:1.01}.console-heading p{font-size:15px;line-height:1.5;max-width:310px}.console-heading .pill{min-height:48px}.console-metrics{gap:0;margin-bottom:28px}.console-metric{padding:20px 12px}.console-metric .mono{font-size:9px;letter-spacing:.8px}.console-metric strong{font-size:38px;margin:14px 0 6px}.console-metric>span{font-size:11px;line-height:1.4}.workspace-appbar{position:fixed;display:grid;grid-template-columns:repeat(5,1fr);left:0;right:0;bottom:0;z-index:1000;padding:10px 8px calc(10px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid var(--line);box-shadow:0 -8px 30px #19191906}.workspace-appbar button{border:0;background:none;display:flex;align-items:center;flex-direction:column;justify-content:center;gap:4px;min-width:0;min-height:48px;padding:0 2px;color:var(--muted);position:relative;font-size:10px;font-weight:500}.workspace-appbar button svg{width:25px;height:25px;overflow:visible}.workspace-appbar button.active{color:var(--ink)}.workspace-appbar button.active:before{content:'';position:absolute;width:20px;height:2px;background:var(--orange);top:-10px}.console-foot{font-size:9px;gap:20px;line-height:1.5}.console-table-wrap{overflow:auto;-webkit-overflow-scrolling:touch}.console-table th,.console-table td{white-space:nowrap}.console-table td:first-child{min-width:180px}.console-note a{margin-left:0}.console-drawer{width:100%;top:0;bottom:0;height:100dvh;padding-bottom:env(safe-area-inset-bottom)}.drawer-form{padding:24px 20px 40px}.drawer-form input,.drawer-form select,.drawer-form textarea,.table-toolbar input,.table-toolbar select{font-size:16px;min-height:48px}.drawer-form .form-row{grid-template-columns:1fr}.drawer-head{padding:24px 20px}.drawer-head h2{font-size:32px}.drawer-close{width:44px;height:44px}.console-object-grid{gap:16px}.object-actions button,.quiet-button{min-height:44px}.console-object h2{overflow-wrap:anywhere}#workspace-more{margin:auto 12px calc(86px + env(safe-area-inset-bottom));width:calc(100% - 24px)}.console-empty{padding:36px 18px}.console-empty p{font-size:14px;line-height:1.5}}

.dashboard-page .tl-header{height:96px;padding:36px 48px}.dashboard-page #page-content{padding-top:96px}@media(max-width:700px){.dashboard-page .tl-header{height:96px;padding:36px 16px}.console-drawer{max-width:none;width:100vw;right:0}.drawer-form .field>span{font-size:11px;line-height:1.5;letter-spacing:.6px}.console-heading{padding-top:8px}.console-mast{margin-bottom:14px}}

#workspace-more{max-height:calc(100dvh - 112px);overflow-y:auto;overscroll-behavior:contain;padding:20px 24px}#workspace-more>button{min-height:56px;padding:14px 0}#workspace-more .more-site-links{display:grid;grid-template-columns:1fr 1fr;gap:0 24px;padding-top:24px}#workspace-more .more-site-links>.mono{grid-column:1/-1;margin-bottom:8px}#workspace-more .more-site-links a{display:flex;gap:12px;justify-content:space-between;align-items:center;font-size:14px;min-height:48px;border-bottom:1px solid var(--line)}#workspace-more .more-site-links a:hover{color:var(--orange)}
@media(max-width:700px){#workspace-more{position:fixed;inset:auto 0 calc(78px + env(safe-area-inset-bottom)) 0;margin:0 auto;width:calc(100% - 24px);max-height:calc(100dvh - 110px)}#workspace-more>.panel-head{margin:0 0 8px}#workspace-more>button{padding:13px 0;min-height:56px}}

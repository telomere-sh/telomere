import {mountMotion} from './motion.js';
import {fixAgentPanels} from './agent-panels.js';
import {mountGuarantees} from './proof-chain.js';
export const icon=name=>`<svg class="icon" viewBox="0 0 40 40" aria-hidden="true"><use href="/assets/tech/icons.svg#${name}"></use></svg>`;
const $=(s,r=document)=>r.querySelector(s);
let path=decodeURIComponent(location.pathname).replace(/\/$/,'')||'/';
let isHome=path==='/';
let brandData={text:{},images:{}};const brandingReady=fetch('/brand-map.json').then(r=>r.json()).then(v=>brandData=v).catch(()=>{});
const brandedText=new WeakMap();
function sanitizeNative(){
 const root=$('#main');if(!root)return;
 const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let node;
 while(node=walker.nextNode()){
  if(['SCRIPT','STYLE'].includes(node.parentElement?.tagName))continue;
  const value=node.nodeValue;if(brandedText.get(node)===value)continue;
  const key=value.trim(),replacement=key.length>3?brandData.text[key]:null;
  if(replacement!=null)node.nodeValue=value.replace(key,replacement);
  if(node.nodeValue.includes('Design & Marketing Agency'))node.nodeValue=node.nodeValue.replace('Design & Marketing Agency','Compute for AI agents');
  brandedText.set(node,node.nodeValue);
 }
 for(const img of root.querySelectorAll('img')){const src=img.getAttribute('src')||'',base=src.split('?')[0];if(brandData.images[base]){img.src=brandData.images[base];img.removeAttribute('srcset')}if(brandData.text[img.alt])img.alt=brandData.text[img.alt];if(/Framer template|Xzero Screen|Woman wearing/i.test(img.alt))img.alt='Compute infrastructure'}
}
export function toast(text){let el=$('.toast');if(!el){el=document.createElement('div');el.className='toast';el.role='status';document.body.append(el)}el.textContent=text;el.classList.add('show');clearTimeout(el.timer);el.timer=setTimeout(()=>el.classList.remove('show'),3500)}
const link=(label,href,primary=false)=>`<a class="pill${primary?' primary':''}" href="${href}">${label}<span class="arrow">↗</span></a>`;
const nav=[['Home','/'],['Protocol','/protocol/'],['Compute','/compute/'],['For hosts','/hosts/'],['Field notes','/learn/'],['Workspace','/dashboard/']];
function socialIcon(name){const paths={github:'M12 .8a11.3 11.3 0 0 0-3.58 22.02c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.03-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.5-.29-5.14-1.26-5.14-5.59 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16A10.8 10.8 0 0 1 12 6.28c.96 0 1.92.13 2.82.38 2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.34-2.64 5.3-5.16 5.58.41.35.77 1.04.77 2.1v3.09c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .8Z',telegram:'m21.7 3.2-3.4 17c-.3 1.2-1 1.5-2 .9l-5.2-3.8-2.5 2.4c-.3.3-.5.5-1 .5l.4-5.3L17.6 6c.4-.4-.1-.6-.6-.3L5.1 13.2 0 11.6c-1.1-.3-1.1-1.1.2-1.6L20.3 2c.9-.3 1.7.2 1.4 1.2Z',x:'M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l8.2-9.4L2.8 2h6.4l4.5 6.7L18.9 2Zm-1.1 18h1.7L8.2 3.9H6.4L17.8 20Z'};return `<svg viewBox="-2 -2 28 28" aria-hidden="true"><path d="${paths[name]}" fill="currentColor"/></svg>`}
function socialLinks(){return ['GitHub','Telegram','X'].map(n=>`<a href="#coming-soon-${n.toLowerCase()}" class="social-link" data-social="${n}"><span class="social-icon">${socialIcon(n.toLowerCase())}</span>${n==='X'?'<span class="sr-only">X</span>':n}</a>`).join('')}
function shell(){
 const host=$('#telomere-shell');
 host.innerHTML=`<header class="tl-header ${isHome?'on-dark':''}"><a class="tl-logo" href="/" aria-label="Telomere home"><img src="/assets/brand/mark.svg" alt="">TELOMERE</a><div class="header-actions"><button class="menu-button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu"><i></i><i></i></button></div></header><nav id="site-menu" class="tl-menu" aria-label="Main navigation" inert><div class="tl-menu-intro"><div><div class="eyebrow">Compute for AI agents</div><p>Pay for the seconds that ran.<br><span class="orange">Get the rest back.</span></p></div><div class="mono">One protocol. Many suppliers.<br>USDC on Base.</div></div><div class="tl-menu-links"><span class="mono muted">Menu</span><div>${nav.map(([n,h])=>`<a href="${h}">${n==='X'?'<span class="sr-only">X</span>':n}</a>`).join('')}</div></div><div class="tl-menu-social"><span class="mono muted">Community</span><div>${socialLinks()}</div></div><div class="tl-menu-bottom"><span>© 2026 TELOMERE</span><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div></nav>`;
 const button=$('.menu-button'),menu=$('.tl-menu');
 const close=()=>{menu.classList.remove('open');menu.inert=true;button.setAttribute('aria-expanded','false');button.setAttribute('aria-label','Open menu');document.body.style.overflow='';updateHeader()};
 button.onclick=()=>{const open=!menu.classList.contains('open');menu.classList.toggle('open',open);menu.inert=!open;button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Close menu':'Open menu');document.body.style.overflow=open?'hidden':'';if(open){$('.tl-header').classList.remove('on-dark');menu.querySelector('a').focus()}else updateHeader()};
 document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if(e.key==='Tab'&&menu.classList.contains('open')){const links=[button,...menu.querySelectorAll('a')],first=links[0],last=links.at(-1);if(e.shiftKey&&document.activeElement===first){last.focus();e.preventDefault()}else if(!e.shiftKey&&document.activeElement===last){first.focus();e.preventDefault()}}});
 {
  const footer=document.createElement('footer');footer.className='tl-footer';footer.innerHTML=`<div class="footer-top"><div><div class="eyebrow">Compute for AI agents</div><p>Every second proven.<br><span class="orange">Every failure refunded.</span></p><span class="mono">By the second. USDC on Base.</span></div><div class="footer-links"><span class="mono">Explore</span>${nav.slice(1,5).map(([n,h])=>`<a href="${h}">${n} ↗</a>`).join('')}</div><div class="footer-links"><span class="mono">Build</span><a href="/dashboard/">Workspace ↗</a><a href="/developers/">API, SDK & MCP ↗</a><a href="/learn/receipts/">Receipt standard ↗</a><a href="/hosts/">Host Kit ↗</a></div></div><div class="footer-community">${socialLinks()}</div><div class="footer-bottom"><span>© 2026 TELOMERE</span><span>COMPUTE / RECEIPTS / CONTINUITY</span><div><a href="/privacy/">Privacy</a> &nbsp; / &nbsp; <a href="/terms/">Terms</a></div></div>`;document.body.append(footer);
 }
}
function updateHeader(){const native=$('.framer-2uznpr-container'),proof=$('#proof-chain'),r=proof?.getBoundingClientRect();native?.classList.toggle('tl-native-dark',!!(isHome&&r&&r.top<70&&r.bottom>70&&native.getBoundingClientRect().height<130));if($('.tl-menu.open'))return;let dark=false;if(isHome){const hero=[...document.querySelectorAll('#main section')].find(e=>e.getBoundingClientRect().height>0);const r=hero?.getBoundingClientRect();dark=r?r.top<=40&&r.bottom>60:scrollY<innerHeight*.82}const sections=[...document.querySelectorAll('.dark,.tl-footer')];if(sections.some(n=>{let r=n.getBoundingClientRect();return r.top<50&&r.bottom>50}))dark=true;$('.tl-header')?.classList.toggle('on-dark',dark)}
shell();addEventListener('scroll',updateHeader,{passive:true});addEventListener('resize',updateHeader,{passive:true});
const pageHero=(label,title,text,meta='TELOMERE / PROTOCOL 01')=>`<section class="page-hero"><div class="eyebrow">${label}</div><h1>${title}</h1><div class="intro"><div class="mono muted">${meta}<br>COMPUTE FOR AI AGENTS<br>USDC ON BASE</div><p>${text}</p></div></section>`;
const top=(label,title,text)=>`<div class="section-top"><div><div class="eyebrow">${label}</div><h2>${title}</h2></div><p>${text}</p></div>`;
const cta=(title='The next run.<br>Your rules.')=>`<section class="page-cta"><h2>${title}</h2>${link('Open workspace','/dashboard/')}</section>`;
const faq=[['What do I pay for?','Authorize a ceiling before a run. Settlement covers only the metered seconds recorded in a signed receipt, and the unused remainder returns to the payer.'],['What happens when a host fails?','Unreceipted time is never charged. The run can resume from an available Cyst on an eligible host. Collateral penalties apply according to the host fault and the protocol rules.'],['Can an agent exceed its budget?','A Leash defines hourly and daily spending caps, permitted hardware, regions, images, expiry, and an owner kill switch. The escrow contract checks the Leash.'],['What is a Cyst?','A Cyst is an encrypted, portable snapshot of agent state. It is stored off-host and registered by hash so an agent can resume on another machine.'],['What is sealed compute?','Sealed hosts combine Intel TDX and NVIDIA confidential computing. Attestation adds evidence about the host environment; current CPU–GPU device binding and physical-attack limitations still apply.'],['What does the platform charge?','Standard Cells and interruptible capacity add a 9% platform fee to the host price. Sealed hosts add 12%. Storage and resume operations have separate charges.'],['Which assets and networks are supported?','Compute settles in native USDC on Base. The specification also supports Solana USDC for top-ups credited on Base. These are payment and infrastructure routes, rather than partnership claims.']];
const faqHTML=()=>`<div class="faq-list">${faq.map(([q,a])=>`<details><summary>${q}</summary><p>${a}</p></details>`).join('')}</div>`;
const cards=[['cell','Cells','CPU and GPU containers, priced by the second. Pick your hardware, image, and spending ceiling.'],['receipt','Run Receipts','Signed ticks connect running time to a public receipt and an escrow settlement.'],['leash','Leashes','A spending policy the agent cannot exceed. Owner-defined limits, filters, expiry, and a kill switch.'],['cyst','Cysts','Encrypted state beyond the life of a host. Snapshot and resume on eligible compute.'],['meter','Metabolism','Full, Lean, Torpor, and Cyst. Step down compute as the agent’s remaining budget falls.'],['settlement','Selection','A public record of agents that earn, spend, reproduce, and eventually go dormant or die.']];
function protocol(){return pageHero('The protocol','Compute ends.<br><span class="orange">State continues.</span>','A common settlement standard for autonomous work. Every run has a ceiling. Every billable second has a receipt. Every agent stays within its owner’s rules.')+`<div class="wide-photo"><img src="/assets/tech/editorial/pcb-pattern.jpg" alt="Precisely machined computer hardware"><span class="photo-label">01 / HARDWARE CHANGES. THE STANDARD DOES NOT.</span></div><section class="section">${top('Primitives','A system built<br>around the run.','Compute, spending, state, and settlement belong in one lifecycle. Six primitives give agents a consistent way to use many suppliers.')}<div class="rule-grid">${cards.map(([i,h,p],j)=>`<div class="rule-card reveal"><span class="mono">[ 0${j+1} ]</span>${icon(i)}<h3>${h}</h3><p>${p}</p></div>`).join('')}</div></section><section class="motion-section"><div class="eyebrow">The receipt lifecycle / 15 seconds</div><div data-motion="protocol"></div><div class="motion-caption mono"><span>AUTHORIZE → METER → PERSIST → SETTLE</span><a href="/assets/video/telomere-protocol-film.mp4" download>DOWNLOAD FILM ↓</a></div></section><section class="section dark">${top('Lifecycle','Four steps.<br>One record.','A ceiling sets the terms. Metering records the work. State preserves continuity. Settlement closes the loop.')} ${[['01','Authorize','Define hardware, an image, and a maximum spend. A Leash filters the eligible capacity.'],['02','Execute','The host signs meter ticks every five seconds. A workload heartbeat confirms liveness.'],['03','Preserve','Checkpoint encrypted state on a schedule, on pre-emption, or when the budget changes.'],['04','Settle','An hourly receipt root connects signed usage to the on-chain settlement. Unused escrow returns.']].map(([n,h,p])=>`<div class="stack-row reveal"><h3><span class="mono orange">${n}</span> &nbsp; ${h}</h3><p>${p}</p>${icon(n==='01'?'leash':n==='02'?'meter':n==='03'?'cyst':'receipt')}</div>`).join('')}</section><section class="section">${top('Mechanics','Clear answers.','The details behind a second of compute.')} ${faqHTML()}</section>`+metabolismSection()+cta()}
const hardware=[{name:'CPU',cat:'cpu',img:'editorial/cpu-contacts.jpg',desc:'General-purpose Linux sandboxes for tools, orchestration, and scheduled work.',tag:'gVisor / Linux',lane:'Standard / Interruptible'}, {name:'RTX',cat:'gpu',img:'editorial/gpu-rtx.jpg',desc:'Flexible GPU capacity for inference, experiments, and smaller model workloads.',tag:'GPU / NVIDIA',lane:'Standard / Interruptible'},{name:'A100',cat:'gpu',img:'editorial/memory-ddr5.jpg',desc:'High-memory GPU capacity for batch inference and demanding model workloads.',tag:'GPU / NVIDIA',lane:'Standard / Interruptible'},{name:'H100',cat:'gpu',img:'editorial/thermal-cooler.jpg',desc:'High-performance compute with class probes before a workload starts.',tag:'GPU / NVIDIA',lane:'Standard / Sealed'},{name:'H200',cat:'sealed',img:'editorial/server-cabinets.jpg',desc:'Memory-focused GPU capacity, with sealed configurations where available.',tag:'GPU / Confidential',lane:'Standard / Sealed'},{name:'B200',cat:'sealed',img:'editorial/thermal-fan.jpg',desc:'Advanced GPU capacity, quoted per second from eligible suppliers.',tag:'GPU / Confidential',lane:'Where available'}];
function compute(){return pageHero('Compute','One API.<br><span class="orange">Many machines.</span>','CPU sandboxes and GPU containers across eligible hosts. Choose a hardware class, set a ceiling, and keep the record of what ran.','TELOMERE / COMPUTE 02')+`<section class="section" style="padding-top:20px"><div class="tabs" id="hardware-tabs"><button class="active" data-filter="all">All compute</button><button data-filter="cpu">CPU</button><button data-filter="gpu">GPU</button><button data-filter="sealed">Sealed</button></div><div class="hardware-grid">${hardware.map(h=>`<article class="hardware-card reveal" data-category="${h.cat}"><img src="/assets/tech/${h.img}" alt="${({CPU:"Processor contacts",RTX:"NVIDIA GeForce RTX graphics card",A100:"Processor and memory components",H100:"Computer thermal management",H200:"Server cabinets",B200:"Compute cooling system"})[h.name]}"><div class="card-heading"><span class="mono">${h.tag}</span>${icon('cell')}</div><div><h3>${h.name}</h3><p>${h.desc}</p></div><div class="card-bottom"><span class="mono">${h.lane}</span><button data-configure="${h.name}" aria-label="Configure ${h.name} cell">↗</button></div></article>`).join('')}</div></section><section class="section dark">${top('Execution boundaries','One workload.<br>A clear boundary.','The Host Kit checks the declared class, isolates execution, and records the work.')}<div class="rule-grid">${[['cell','Isolated by design','CPU Cells use gVisor. GPU Cells use gVisor with nvproxy or Kata Containers. One tenant occupies a GPU.'],['receipt','Measured before billing','Admission benchmarks and a warm check probe each GPU run before user billing begins.'],['cyst','State can move','Encrypted Cysts are stored off-host and registered by hash so work can resume on eligible capacity.']].map(([i,h,p])=>`<div class="rule-card">${icon(i)}<h3>${h}</h3><p>${p}</p></div>`).join('')}</div></section><section class="section">${top('Run planner','Define the work.<br>Set the boundary.','Prepare a configuration for your workspace. Host pricing is entered explicitly, so the plan never assumes a live supplier quote.')}<form id="compute-planner" class="inline-form"><div class="form-row"><label class="field"><span>Hardware class</span><select name="hardware">${hardware.map(h=>`<option>${h.name}</option>`).join('')}</select></label><label class="field"><span>Lane</span><select name="lane"><option>Standard</option><option>Interruptible</option><option>Sealed</option></select></label></div><div class="form-row"><label class="field"><span>Duration in minutes</span><input name="minutes" type="number" min="1" max="1440" value="60" required></label><label class="field"><span>Host rate / hour in USDC</span><input name="rate" type="number" min="0" step="0.01" value="1.00" required></label></div><div class="form-summary"><span class="mono">Estimated ceiling</span><strong id="plan-price">1.09 USDC</strong></div><button class="pill primary" type="submit">Use this configuration <span>↗</span></button></form></section>`+cta('A ceiling first.<br>Then compute.')}
function hosts(){return pageHero('For hosts','Your machines.<br><span class="orange">One standard.</span>','Supply CPU and GPU capacity through the Telomere Host Kit. A posted price, measurable performance, and signed records for work completed.','TELOMERE / SUPPLY 03')+`<div class="wide-photo"><img src="/assets/tech/editorial/server-equipment.jpg" alt="Server racks with organized storage and cabling"><span class="photo-label">INDEPENDENT HARDWARE / ACCOUNTABLE SUPPLY</span></div><section class="section">${top('Host Kit','Built to measure.<br>Designed to isolate.','A host daemon coordinates work while an independent meter and workload heartbeat establish liveness. Images are allowlisted by digest.')}<div class="rule-grid">${[['host','Register','Generate a host key and register eligible hardware. CPU-only hosts post a minimum 300 USDC collateral; GPU hosts post 1,500 USDC.'],['compute','Prove the class','Admission benchmarks check compute performance and memory. A warm check probes each GPU run before user billing begins.'],['meter','Meter the run','Five-second signed ticks and an in-cell heartbeat establish billable running time. Three missed ticks indicate a host fault.']].map(([i,h,p],n)=>`<div class="rule-card reveal"><span class="mono">0${n+1}</span>${icon(i)}<h3>${h}</h3><p>${p}</p></div>`).join('')}</div></section><section class="section dark">${top('Isolation','A boundary for<br>every workload.','CPU cells use gVisor. GPU cells use gVisor with nvproxy or Kata Containers. Sealed hosts add confidential computing.')}<div class="stack-row"><h3>One tenant per GPU.</h3><p>GPU capacity is isolated per workload. Egress follows the permitted destinations for the agent.</p>${icon('cell')}</div><div class="stack-row"><h3>Hardware probes.</h3><p>Random benchmarks, memory checks, and optional deterministic re-execution support the metering standard.</p>${icon('receipt')}</div><div class="stack-row"><h3>Unbonding period.</h3><p>Host collateral has a 21-day unbonding delay and remains blocked while runs are open.</p>${icon('leash')}</div></section><section class="section">${top('Host profile','Prepare your<br>capacity profile.','Save a host configuration in your workspace and export it for integration with the Host Kit.')}<form id="host-profile" class="inline-form"><label class="field"><span>Machine label</span><input name="label" placeholder="gpu-supply-01" required maxlength="40"></label><div class="form-row"><label class="field"><span>Hardware</span><select name="hardware">${hardware.map(h=>`<option>${h.name}</option>`).join('')}</select></label><label class="field"><span>Region</span><select name="region"><option>Asia Pacific</option><option>Europe</option><option>North America</option></select></label></div><label class="field"><span>Posted hourly rate / USDC</span><input name="rate" type="number" value="1" min="0.01" step="0.01" required></label><button class="pill primary">Save host profile <span>↗</span></button></form></section>`+cta('Put capacity<br>to work.')}
const notes=[['receipts','Why every billed second needs a receipt','A signed chain from metering to escrow settlement.','editorial/pcb-signal.jpg','METERING / 01'],['leashes','A spending policy an agent cannot exceed','How caps, filters, expiry, and a kill switch fit together.','editorial/network-patch.jpg','CONTROL / 02'],['cysts','State beyond the life of a machine','Encrypted snapshots, rolling leases, and a resumable workload.','editorial/storage-stack.jpg','CONTINUITY / 03'],['selection','A public record of agents that pay their way','Income, spending, offspring, dormancy, and the Fossil Record.','editorial/network-rack.jpg','SELECTION / 04']];
function learn(){return pageHero('Field notes','Inside<br><span class="orange">the protocol.</span>','The mechanics behind metered compute, bounded spending, portable state, and the public life of autonomous agents.','TELOMERE / KNOWLEDGE 04')+`<section class="section" style="padding-top:0"><div class="note-grid">${notes.map(([slug,h,p,img,tag])=>`<a class="note-card reveal" href="/learn/${slug}/"><img src="/assets/tech/${img}" alt="Technology detail for ${slug}"><div class="mono muted">${tag}</div><h2>${h}</h2><p>${p}</p><span class="text-link">Read the note <span>↗</span></span></a>`).join('')}</div></section>`+cta()}
const articleContent={
 receipts:[['A ceiling is an authorization','Opening a run defines a maximum amount, a hardware class, a price per second, a maximum duration, an image hash, and the owner’s Leash. The ceiling bounds the amount settlement can pay.'],['A second needs evidence','The meter emits a signed tick every five seconds. A billable second falls between consecutive valid ticks with the cell running and the in-cell heartbeat present. The control plane countersigns received ticks.'],['A receipt closes the loop','A receipt contains the run and host identifiers, hardware class, image digest, start and stop time, billable seconds, per-second price, settled amount, probe result, and a Merkle root of the run’s ticks. Hourly roots are published on Base.'],['Verify the record','The verifier connects tick signatures to the registered host key, checks the receipt leaf against its hourly root, and compares the settled amount with escrow events. Non-TEE hosts are measured and probed; sealed hosts add attestation evidence.']],
 leashes:[['Authority has a boundary','The owner chooses the agent signer and a set of rules: maximum spending per hour and day, allowed hardware classes, regions, image digests, expiry, and whether sealed hosts are required.'],['Enforced where funds move','The escrow checks a Leash when opening and settling a run. The control plane mirrors the restrictions so placement follows the same policy. A killed Leash cannot authorize new runs.'],['The owner keeps the switch','An owner can kill a Leash. Open runs are stopped within a meter tick and settled only for receipted time. Unspent balances remain withdrawable.'],['Funds need not become a bearer balance','A Base Account spend permission or a deposit can fund the run ceiling. The owner can scope access instead of placing a large unrestricted balance in an agent’s wallet.']],
 cysts:[['State lives off-host','A Cyst can include the writable filesystem layer, declared state directories, and supported process checkpoints. The snapshot is compressed, encrypted, replicated, and registered by hash.'],['A snapshot has triggers','Cysts can be taken on a schedule, before interruptible pre-emption, when a Leash budget is exhausted, on a Metabolism step-down, or on owner request. The default schedule in the build specification is every fifteen minutes.'],['Resume with verification','The new cell pulls the snapshot, verifies the hash, and decrypts it. Sealed hosts release decryption keys only after quote verification. Process checkpoint support depends on the workload and driver.'],['Metabolism preserves a path back','Full, Lean, Torpor, and Cyst tiers respond to remaining hours at the current burn rate. At the lowest tier, compute pauses and the encrypted state remains in storage until a top-up.']],
 selection:[['An opt-in population','Selection gives each agent an identity, a vault, a Leash, and a public view of remaining compute life. Agents earn through declared services and pay their own compute costs.'],['Income has a definition','Verified income excludes owner top-ups and circular funding from parents, children, or Telomere itself. Owner contributions are recorded separately as subsidy.'],['Offspring and dormancy','An agent can fund at most three living children from its own vault. The child receives a fork of the parent’s Cyst and a new owner-set Leash. Low balances lead to dormancy, with death after the specified grace period.'],['The Fossil Record','Births, income, burn, dormancy, and deaths become public events. Population statistics derive from those events and receipts. Owners retain a kill switch and can withdraw their balances.']]
};
function article(slug){const n=notes.find(n=>n[0]===slug)||notes[0],body=articleContent[n[0]];return pageHero(n[4],n[1],n[2],'TELOMERE / PROTOCOL NOTE')+`<div class="wide-photo" style="max-height:500px"><img src="/assets/tech/${({receipts:"editorial/pcb-capacitors.jpg",leashes:"editorial/network-blue.jpg",cysts:"editorial/storage-open.jpg",selection:"editorial/memory-modules.jpg"})[n[0]]}" alt="${n[0]} hardware detail"></div><section class="article"><aside>TELOMERE FIELD NOTES<br>OCTOBER 2026<br><br>${body.map(([h],i)=>`<a href="#part-${i}">0${i+1} ${h}</a><br>`).join('')}<br><a href="/learn/">← All field notes</a></aside><div class="article-body">${body.map(([h,p],i)=>`<h2 id="part-${i}">${h}</h2><p>${p}</p>`).join('')}${link('Configure a run','/dashboard/',true)}</div></section>`}
function developers(){return pageHero('Interfaces','Built for<br><span class="orange">agent workflows.</span>','One API, a Streamable HTTP MCP server, and TypeScript and Python SDK interfaces. Compute belongs inside the workflow, with a clear spending boundary.')+`<section class="section" style="padding-top:0">${top('API / SDK / MCP','A common language<br>for every run.','Use the workspace to prepare a configuration and export its request. Every interface is designed around the same compute primitives.')}<div class="tabs" id="code-tabs"><button class="active" data-code="ts">TypeScript</button><button data-code="py">Python</button><button data-code="mcp">MCP</button></div><pre class="code-block" id="code-example"></pre><button class="pill" id="copy-code">Copy snippet ↗</button></section><section class="section dark">${top('Technology','A stack for<br>accountable compute.','Technology and interface references from the specification. These are infrastructure choices and supported adapter targets.')}<div class="brand-grid">${[['base.svg','Base'],['nvidia.svg','NVIDIA'],['usdc.svg','USDC'],['akash.svg','Akash'],['nosana.svg','Nosana'],['golem-black.svg','Golem']].map(([f,n])=>`<div class="brand-tile"><img src="/assets/tech/${f}" alt="${n}"></div>`).join('')}</div></section>`+cta()}
function legal(kind){let privacy=kind==='privacy';return pageHero(privacy?'Privacy':'Terms',privacy?'Your workspace.<br>Your device.':'Clear boundaries.<br>Before the run.',privacy?'Workspace configurations are stored in this browser. Export your records, or clear local workspace data from Settings.':'Understand the scope of the website, the workspace, and the compute protocol.')+`<section class="article"><aside>TELOMERE / ${kind.toUpperCase()}</aside><div class="article-body">${privacy?'<h2>Browser storage</h2><p>The workspace stores run configurations, budgets, host profiles, and preferences in local browser storage. Clearing browser data removes those records from this device.</p><h2>No contact collection</h2><p>This site has no email subscription or contact form. The frontend does not collect a mailing list or transmit workspace configurations to a compute service.</p><h2>Media</h2><p>Photography, technology marks, fonts, and sound assets are served with the site. Embedded animations run silently. Downloadable films include their soundtrack.</p>':'<h2>Configurations and records</h2><p>The workspace prepares configurations and exports records. Creating or saving a configuration here does not reserve compute, open on-chain escrow, move funds, or produce a host-signed run receipt.</p><h2>Protocol specifications</h2><p>Compute, metering, settlement, and state behavior follow the supplied Telomere specifications. Hardware availability, supplier pricing, supported images, and confidential-computing capabilities depend on the integrated infrastructure.</p><h2>Owner control</h2><p>Review hardware terms, spending ceilings, and the Leash before submitting a run through a connected service. Never place signing keys into workload configuration fields.</p>'}</div></section>`}
const routeCache=new Map();let homePrepared=!!$('#main'),homePromise,rootDocument,homeReady=false;
async function prepareHome(){if(homePrepared)return;if(homePromise)return homePromise;homePromise=(async()=>{const text=rootDocument||await fetch('/').then(r=>r.text()),doc=new DOMParser().parseFromString(text,'text/html');for(const style of doc.querySelectorAll('style')){style.dataset.nativeStyle='';document.head.append(style.cloneNode(true))}let css=document.querySelector('link[href="/home.css"]');if(!css){css=document.createElement('link');css.rel='stylesheet';css.href='/home.css';css.disabled=!isHome;document.head.append(css)}const root=doc.querySelector('#main');root.dataset.routeRestored='true';root.dataset.pagePreparing='true';root.hidden=!isHome;document.body.insertBefore(root,$('#telomere-shell'));for(const old of doc.querySelectorAll('script')){if(old.src.endsWith('/site.js')||old.textContent.includes('editorbar')||old.textContent.includes('function u(){function n(t,e,i)'))continue;const script=document.createElement('script');for(const a of old.attributes)script.setAttribute(a.name,a.value);script.textContent=old.textContent;document.body.append(script)}homePrepared=true;setTimeout(initHome,1400)})();return homePromise}
async function populatePage(main){
 if(path.startsWith('/dashboard')){await import('./dashboard.js')}
 else if(['/protocol','/about-us'].includes(path))main.innerHTML=protocol();
 else if(['/compute','/projects'].includes(path))main.innerHTML=compute();
 else if(['/hosts','/jobs'].includes(path))main.innerHTML=hosts();
 else if(['/learn','/articles'].includes(path))main.innerHTML=learn();
 else if(path.startsWith('/learn/')||path.startsWith('/articles/'))main.innerHTML=article(path.split('/')[2]);
 else if(path==='/developers')main.innerHTML=developers();
 else if(path==='/privacy'||path.includes('privacy'))main.innerHTML=legal('privacy');
 else if(path==='/terms'||path.includes('terms')||path.includes('cookie'))main.innerHTML=legal('terms');
 else main.innerHTML=pageHero('404','That route<br>has ended.','The protocol continues. Return to the home page or open your workspace.')+`<section class="section">${link('Return home','/',true)}</section>`;

 document.title=(path.startsWith('/dashboard')?'Workspace':path.split('/')[1]?.replace(/^./,c=>c.toUpperCase())||'Telomere')+' | Telomere';
}
async function renderRoute(){
 path=decodeURIComponent(location.pathname).replace(/\/$/,'')||'/';isHome=path==='/';
 for(const el of routeCache.values()){el.hidden=true;el.inert=true;el.removeAttribute('id')}
 const initial=$('#page-content');if(initial&&!routeCache.size){initial.remove()}
 document.body.classList.toggle('tl-page',!isHome);document.body.classList.toggle('dashboard-page',path.startsWith('/dashboard'));document.body.classList.toggle('home-route',isHome);
 const css=document.querySelector('link[href="/home.css"]');if(css)css.disabled=!isHome;
 if(isHome){await prepareHome();$('#main').dataset.pagePreparing='true';$('#main').hidden=false;document.title='Telomere | Every second proven';setTimeout(initHome,1400)}
 else{if($('#main'))$('#main').hidden=true;let page=routeCache.get(path);if(!page){page=document.createElement('main');page.id='page-content';page.dataset.pagePreparing='true';document.body.insertBefore(page,$('.tl-footer'));routeCache.set(path,page);await populatePage(page);bindPage(page)}else{page.id='page-content';page.dataset.pagePreparing='true';page.hidden=false;page.inert=false;if(path.startsWith('/dashboard')&&new URLSearchParams(location.search).has('configure'))page.openConfiguration?.()}}
 if(!isHome)document.title=(path.startsWith('/dashboard')?'Workspace':path.split('/')[1]?.replace(/^./,c=>c.toUpperCase())||'Telomere')+' | Telomere';$('.tl-footer').hidden=isHome||path.startsWith('/dashboard');if(isHome){if(!homeReady){await brandingReady;await new Promise(r=>setTimeout(r,1400));initHome();homeReady=true}homeEnhancements()}const activeRoot=isHome?$('#main'):$('#page-content');await window.TelomereAssets?.prepare(activeRoot);if(activeRoot)delete activeRoot.dataset.pagePreparing;window.TelomereAssets?.reveal();updateHeader();requestAnimationFrame(()=>dispatchEvent(new Event('resize')));
}
let navigating=false;
async function navigate(href,replace=false){if(navigating)return;const url=new URL(href,location.href);if(url.pathname===location.pathname&&url.search===location.search&&!url.hash){closeMenu();return}navigating=true;closeMenu();if(!replace)history.pushState({},'',url);const run=async()=>{await renderRoute();window.scrollTo({top:0,behavior:'instant'});if(url.hash)setTimeout(()=>document.getElementById(url.hash.slice(1))?.scrollIntoView(),50)};try{if(document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const transition=document.startViewTransition(run);await transition.updateCallbackDone}else await run()}finally{navigating=false}}
function closeMenu(){for(const d of document.querySelectorAll('dialog[open]'))d.close();const menu=$('.tl-menu');menu?.classList.remove('open');if(menu)menu.inert=true;const b=$('.menu-button');b?.setAttribute('aria-expanded','false');b?.setAttribute('aria-label','Open menu');document.body.style.overflow='';const native=$('.framer-2uznpr-container');if(native?.getBoundingClientRect().height>130)native.querySelector('.framer-1035lth-container > *')?.click()}

function metabolismSection(isLanding=false){return `<section class="metabolism-section" id="${isLanding?'home-metabolism':'metabolism'}"><div class="metabolism-intro"><div><div class="eyebrow">Metabolism</div><h2>Stay running.<br><span class="orange">Spend less.</span></h2></div><p>Compute adapts as available runway falls. Four tiers preserve the work and reduce the burn, within the owner’s Leash.</p></div><div class="metabolism-grid">${[['Full','> 72h','Any permitted hardware.','Use any compute class allowed by the owner’s policy.','cell'],['Lean','24–72h','One class down.','Use a smaller class. GPU capacity is reserved for essential jobs.','compute'],['Torpor','2–24h','CPU, on a schedule.','Wake for scheduled work or an incoming payment.','meter'],['Cyst','< 2h','Preserve the state.','Freeze compute, retain encrypted state, and wake on top-up.','cyst']].map(([name,hours,title,copy,i],n)=>`<article class="metabolism-tier"><div class="tier-top"><span class="mono">0${n+1} / ${name.toUpperCase()}</span>${icon(i)}</div><strong>${hours}</strong><h3>${title}</h3><p>${copy}</p><div class="tier-meter" aria-hidden="true">${Array.from({length:8},(_,j)=>`<i class="${j<8-n*2?'filled':''}"></i>`).join('')}</div></article>`).join('')}</div><div class="metabolism-note"><span class="mono">RUNWAY = VAULT BALANCE ÷ TRAILING 24H BURN</span><a class="text-link" href="/protocol/#metabolism">Explore the lifecycle <span>↗</span></a></div></section>`}
function applyEditorialFixes(root){
 const clients=[...root.querySelectorAll('.framer-56h9ld img')];clients.forEach((img,i)=>{const name=['Base','NVIDIA','USDC','Akash','Nosana','Golem'][i%6];if(img.alt!==name)img.alt=name});const main=root.querySelector('main');for(const pricing of root.querySelectorAll('.framer-JwqgI')){if(!main)continue;let holder=pricing;while(holder.parentElement&&holder.parentElement!==main)holder=holder.parentElement;if(holder.parentElement===main){holder.hidden=true;if(!root.querySelector('#home-metabolism')){const el=document.createElement('div');el.className='metabolism-replacement';el.innerHTML=metabolismSection(true);holder.before(el)}}}
 fixAgentPanels(root);mountGuarantees(root);
 for(const h of root.querySelectorAll('h1,h2,h3'))if(h.textContent==='TELOMERE LAB')h.setAttribute('aria-label','Telomere Lab');
}

function homeEnhancements(){if(isHome&&document.title!=='Telomere | Every second proven')document.title='Telomere | Every second proven';sanitizeNative();const root=$('#main');if(!root)return;applyEditorialFixes(root);for(const a of root.querySelectorAll('a[href]')){const raw=a.getAttribute('href');if(raw.includes('coming-soon')){const key=raw.split('coming-soon-')[1];if(!a.dataset.tlSocial){a.dataset.tlSocial='1';a.setAttribute('aria-label',key==='x'?'X':key==='github'?'GitHub':'Telegram');const label=a.textContent.trim();a.innerHTML=`<span class="social-icon">${socialIcon(key)}</span><span class="${key==='x'?'sr-only':''}">${label}</span>`;a.classList.add('social-link')}}if(/uihub|framer\.(website|media|ai)|vistiq|avenzor|plywood|huggltwo|charmant|predict|payble/.test(raw))a.href='/developers/';if(raw.startsWith('mailto:'))a.href='/dashboard/';if(raw.startsWith('tel:'))a.href='/protocol/';const text=a.textContent.trim();if(/^(Read the protocol|Read protocol|Inside the protocol|Explore the mechanics)$/.test(text))a.href='/protocol/';if(/^(Configure a cell|Open workspace)$/.test(text))a.href='/dashboard/';if(/^Explore (sealed compute|compute|all compute)$/.test(text))a.href='/compute/';if(text==='Interfaces')a.href='/developers/';if(text==='Base'&&a.closest('.framer-sutttg'))a.hidden=true}for(const col of root.querySelectorAll('.framer-sutttg')){for(const a of col.querySelectorAll('a'))if(a.textContent.trim()==='Base')a.hidden=true}for(const a of root.querySelectorAll('a[href*="framer.link"]')){if(a.textContent.trim()==='Base'){a.hidden=true}else a.href='/developers/'}updateHeader()}
let homeObserved=false;
function initHome(){brandingReady.then(homeEnhancements);if(homeObserved||!$('#main'))return;homeObserved=true;let pending=false;new MutationObserver(()=>{if(pending)return;pending=true;requestAnimationFrame(()=>{pending=false;homeEnhancements()})}).observe($('#main'),{childList:true,subtree:true});}
function initReveal(scope=document){const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}}),{threshold:.05});scope.querySelectorAll('.reveal').forEach(e=>obs.observe(e))}
function bindPage(scope){for(const e of scope.querySelectorAll('div[data-motion]'))if(!e.querySelector('canvas'))mountMotion(e,e.dataset.motion);initReveal(scope);
const tabs=$('#hardware-tabs');if(tabs)tabs.onclick=e=>{const b=e.target.closest('button');if(!b)return;tabs.querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.hardware-card').forEach(c=>{c.hidden=b.dataset.filter!=='all'&&c.dataset.category!==b.dataset.filter;c.style.display=c.hidden?'none':'';c.classList.add('visible')})};
document.querySelectorAll('[data-configure]').forEach(b=>b.onclick=()=>{const s=$('[name=hardware]');s.value=b.dataset.configure;$('#compute-planner').scrollIntoView({behavior:'smooth',block:'center'});s.focus();updatePlan()});
function updatePlan(){const f=$('#compute-planner');if(!f)return;const v=Object.fromEntries(new FormData(f));const fee=v.lane==='Sealed'?.12:.09;$('#plan-price').textContent=((+v.minutes/60)*(+v.rate)*(1+fee)).toFixed(2)+' USDC'}
$('#compute-planner')?.addEventListener('input',updatePlan);
$('#compute-planner')?.addEventListener('submit',e=>{e.preventDefault();sessionStorage.setItem('telomere-pending-plan',JSON.stringify(Object.fromEntries(new FormData(e.currentTarget))));navigate('/dashboard/?configure=1')});
$('#host-profile')?.addEventListener('submit',e=>{e.preventDefault();const v=Object.fromEntries(new FormData(e.currentTarget));const profiles=JSON.parse(localStorage.getItem('telomere-hosts')||'[]');profiles.push({...v,id:crypto.randomUUID(),created:new Date().toISOString()});localStorage.setItem('telomere-hosts',JSON.stringify(profiles));toast('Host profile saved to your workspace.');e.currentTarget.reset()});
const snippets={ts:'const cell = await telomere.cell({\n  class: "H100",\n  maxUsd: 5,\n  leashId: "YOUR_LEASH_ID"\n});\n\nawait cell.exec("python workload.py");\nawait cell.cyst();',py:'cell = await telomere.cell(\n    hardware_class="H100",\n    max_usd=5,\n    leash_id="YOUR_LEASH_ID"\n)\n\nawait cell.exec("python workload.py")\nawait cell.cyst()',mcp:'telomere_quote\ntelomere_run\ntelomere_exec\ntelomere_stop\ntelomere_status\ntelomere_cyst_save\ntelomere_cyst_resume\ntelomere_receipt\ntelomere_leash_get\ntelomere_prices'};
if($('#code-example')){$('#code-example').textContent=snippets.ts;$('#code-tabs').onclick=e=>{const b=e.target.closest('button');if(!b)return;$('#code-tabs').querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));$('#code-example').textContent=snippets[b.dataset.code]};$('#copy-code').onclick=()=>navigator.clipboard.writeText($('#code-example').textContent).then(()=>toast('Snippet copied.')).catch(()=>toast('Select the snippet to copy it.'))}
}
const legacyRoutes={'/about-us':'/protocol/','/projects':'/compute/','/articles':'/learn/','/jobs':'/hosts/','/contact':'/dashboard/'};
window.addEventListener('click',e=>{
 const a=e.target.closest('a[href]');if(!a||e.metaKey||e.ctrlKey||e.shiftKey||a.hasAttribute('download'))return;
 const raw=a.getAttribute('href');if(raw.includes('coming-soon-')){e.preventDefault();e.stopImmediatePropagation();openSocial(a.dataset.social||raw.split('coming-soon-')[1]);return}
 if(raw.startsWith('mailto:')||raw.startsWith('tel:')||/cal\.com|framer\.(link|website|media|ai)|CristianMielu|uihub\.design|polar\.sh/.test(raw)){e.preventDefault();e.stopImmediatePropagation();navigate('/protocol/');return}
 const url=new URL(raw,location.href);if(url.origin!==location.origin||raw.startsWith('#'))return;
 let next=legacyRoutes[url.pathname.replace(/\/$/,'')];if(!next&&url.pathname.startsWith('/projects/'))next='/compute/';if(!next&&url.pathname.startsWith('/articles/')){const names=['the-power-of-minimalism-why-less-is-more-in-design','the-future-of-web-design-trends-you-can-t-ignore','my-web-design-process-from-concept-to-completion','why-investing-in-good-design-pays-off-for-your-business'];next='/learn/'+(['receipts','leashes','cysts','selection'][names.indexOf(url.pathname.split('/')[2])]||'receipts')+'/'}if(!next&&url.pathname.startsWith('/jobs/'))next='/hosts/';
 if(url.pathname!==location.pathname||url.search!==location.search){e.preventDefault();e.stopImmediatePropagation();navigate(next||url.href)}
},true);
addEventListener('popstate',e=>{e.stopImmediatePropagation();renderRoute()},true);
let socialFocus;
function openSocial(name){socialFocus=document.activeElement;closeMenu();let dialog=$('#community-dialog');if(!dialog){dialog=document.createElement('dialog');dialog.id='community-dialog';dialog.innerHTML=`<button class="community-close" aria-label="Close coming soon">×</button><div class="community-mark"></div><div class="mono muted">TELOMERE / COMMUNITY</div><h2>Coming soon.</h2><p></p><button class="pill primary community-done">Back to Telomere <span>↗</span></button>`;document.body.append(dialog);dialog.querySelectorAll('button').forEach(b=>b.onclick=()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});dialog.addEventListener('close',()=>socialFocus?.focus())}name=name[0].toUpperCase()+name.slice(1);if(name==='Github')name='GitHub';$('.community-mark',dialog).innerHTML=socialIcon(name.toLowerCase());$('p',dialog).textContent=`Telomere on ${name}. A new channel for the protocol.`;dialog.showModal()}
await renderRoute();if(isHome){setTimeout(initHome,1400)}else{const warm=()=>fetch('/').then(r=>r.text()).then(t=>rootDocument=t).catch(()=>{});if('requestIdleCallback'in window)requestIdleCallback(warm,{timeout:3000});else setTimeout(warm,1000)}

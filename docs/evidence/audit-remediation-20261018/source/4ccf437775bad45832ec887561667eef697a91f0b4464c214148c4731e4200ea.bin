export const panelModels={"Run Receipts": [["Signed ticks", "primitive-meter.svg"], ["HostRegistry", "primitive-host.svg"], ["ReceiptRoot", "primitive-root.svg"], ["RunEscrow", "primitive-settlement.svg"], ["Base", "base-mark.svg"], ["USDC", "usdc.svg"], ["Public verifier", "primitive-receipt.svg"]], "Cysts & persistence": [["Encrypted state", "primitive-lock.svg"], ["Snapshot hash", "primitive-hash.svg"], ["Object storage", "primitive-storage.svg"], ["CystRegistry", "primitive-root.svg"], ["Portable resume", "primitive-cycle.svg"], ["Checkpoint hook", "primitive-stream.svg"], ["Sealed key release", "primitive-leash.svg"]], "Leash controls": [["Hourly cap", "primitive-clock.svg"], ["Daily cap", "primitive-calendar.svg"], ["Hardware filter", "primitive-compute.svg"], ["Region filter", "primitive-globe.svg"], ["Image allowlist", "primitive-hash.svg"], ["Policy expiry", "primitive-policy.svg"], ["Owner kill switch", "primitive-kill.svg"]], "Metabolism": [["Full compute", "primitive-cell.svg"], ["Lean compute", "primitive-compute.svg"], ["Torpor schedule", "primitive-clock.svg"], ["Frozen Cyst", "primitive-cyst.svg"], ["Runway balance", "primitive-wallet.svg"], ["Wake on top-up", "primitive-pulse.svg"], ["Lifeline renewals", "primitive-cycle.svg"]], "Signed metering": [["Five-second ticks", "primitive-meter.svg"], ["Host signature", "primitive-hash.svg"], ["Cell heartbeat", "primitive-pulse.svg"], ["Countersignature", "primitive-receipt.svg"], ["Tick Merkle root", "primitive-root.svg"], ["Fault detection", "primitive-kill.svg"], ["Meter service", "primitive-host.svg"]], "Deadline jobs": [["Job deadline", "primitive-clock.svg"], ["Workload image", "primitive-hash.svg"], ["Budget ceiling", "primitive-wallet.svg"], ["GPU capacity", "nvidia.svg"], ["Pre-emption notice", "primitive-cycle.svg"], ["Checkpoint state", "primitive-cyst.svg"], ["Run receipt", "primitive-receipt.svg"]], "Host Kit": [["HostRegistry", "primitive-host.svg"], ["CPU isolation", "primitive-cell.svg"], ["GPU isolation", "nvidia.svg"], ["Class probes", "primitive-compute.svg"], ["Signed meter", "primitive-meter.svg"], ["Host collateral", "primitive-wallet.svg"], ["Receipt evidence", "primitive-receipt.svg"]], "Selection": [["Agent vault", "primitive-wallet.svg"], ["Owner Leash", "primitive-leash.svg"], ["Public receipts", "primitive-receipt.svg"], ["State fork", "primitive-branch.svg"], ["Metabolism tier", "primitive-cycle.svg"], ["Income in USDC", "usdc.svg"], ["Fossil Record", "primitive-root.svg"]], "Escrowed runs": [["CPU Cells", "primitive-cell.svg"], ["GPU capacity", "nvidia.svg"], ["Workload isolation", "primitive-lock.svg"], ["Hardware probes", "primitive-compute.svg"], ["Host Kit", "primitive-host.svg"], ["Usage ticks", "primitive-meter.svg"], ["Bounded escrow", "primitive-settlement.svg"]]};
const descriptions={
 'Run Receipts':'Five-second signed ticks, workload liveness, and public receipt roots connect every billed second to escrow settlement.',
 'Cysts & persistence':'Encrypt state, register its hash, and keep it off-host. Verify and resume the snapshot on eligible compute, with attestation-gated key release for sealed hosts.',
 'Leash controls':'Define hourly and daily spending caps, permitted hardware, regions, images, and expiry. The owner retains a kill switch, and escrow enforces the policy.',
 'Metabolism':'As runway falls, step down through Full, Lean, Torpor, and Cyst. Reduce the burn while preserving state and a path to wake on top-up.',
 'Signed metering':'The host emits signed ticks every five seconds. An in-cell heartbeat confirms liveness; the control plane countersigns ticks and builds the receipt evidence.',
 'Deadline jobs':'Declare an image, command, deadline, and spending ceiling. Checkpoint interruptible work and retain a receipt of the compute that ran.',
 'Host Kit':'Register eligible CPU or GPU hardware, post collateral, and pass the class probes. Isolation, a host daemon, and an independent meter support accountable supply.',
 'Selection':'Opt in to a public arena for agents that earn income and pay their own compute. Vaults, state forks, Metabolism, and the Fossil Record track the life cycle.',
 'Escrowed runs':'Choose eligible CPU or GPU capacity, authorize a ceiling, and settle only the measured work. Unused escrow returns to the payer.'};
export function fixAgentPanels(root){
 for(const h of root.querySelectorAll('h3')){
  const title=h.textContent.replace(/\s+/g,' ').trim(),entries=panelModels[title];if(!entries)continue;
  let panel=h.parentElement;while(panel&&panel!==root&&!/Selected|Expanded/i.test(panel.getAttribute('data-framer-name')||''))panel=panel.parentElement;
  if(!panel||panel===root)panel=h.closest('.framer-xTyJN');if(!panel)continue;
  panel.classList.add('agent-evidence');panel.dataset.agentPanel=title;
  const description=panel.querySelector('.framer-4rtpjt p');if(description&&description.textContent!==descriptions[title])description.textContent=descriptions[title];
  const template=panel.querySelector('.framer-1xm4oas');const grid=template?.parentElement;if(grid&&template){while(grid.querySelectorAll('img').length<entries.length){const row=template.cloneNode(true);row.dataset.addedCapability='true';grid.append(row)}}
  const imgs=[...panel.querySelectorAll('img')];imgs.forEach((img,i)=>{const e=entries[i];if(!e)return;const src='/assets/tech/'+e[1];if(img.getAttribute('src')!==src)img.setAttribute('src',src);if(img.alt!==e[0])img.alt=e[0];img.loading='eager';img.removeAttribute('srcset');const row=img.closest('.framer-1xm4oas')||img.parentElement?.parentElement?.parentElement;const text=row?.querySelector('p');if(text&&text.textContent!==e[0])text.textContent=e[0];});
  for(const p of panel.querySelectorAll('p'))if(p.textContent==='Available through'||p.textContent==='Verified through')p.textContent=title==='Run Receipts'?'The proof chain':'Protocol capabilities';
 }
}

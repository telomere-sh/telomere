.wallet-picker{box-sizing:border-box;width:min(480px,calc(100% - 32px));max-height:calc(100dvh - 40px);margin:auto;padding:28px;border:1px solid #d5d2cb;border-radius:16px;background:#f0eee9;color:#191919;font-family:Inter,Arial,sans-serif;overscroll-behavior:contain;box-shadow:0 24px 90px #0004}.wallet-picker::backdrop{background:#19191988;backdrop-filter:blur(5px)}.wallet-picker-head{display:flex;align-items:center;justify-content:space-between;gap:16px}.wallet-picker-head>span{font:10px monospace;letter-spacing:1.4px;color:#77766f}.wallet-picker-head button{width:44px;height:44px;flex-shrink:0;border:1px solid #d5d2cb;border-radius:50%;background:transparent;color:inherit;font-size:26px;cursor:pointer}.wallet-picker h2{margin:18px 0 12px;font-size:34px;line-height:1.1;letter-spacing:-1.5px;font-weight:500}.wallet-picker p{font-size:14px;line-height:1.55}.wallet-picker-list{display:grid;gap:8px;margin:24px 0}.wallet-picker-option{display:flex;align-items:center;gap:13px;min-height:64px;width:100%;padding:12px;border:1px solid #d5d2cb;border-radius:10px;background:transparent;color:#191919;text-align:left;font:inherit;cursor:pointer}.wallet-picker-option:hover{background:#e7e5e0;border-color:#77766f}.wallet-picker-option:active{background:#dedbd3}.wallet-picker-badge{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;border-radius:8px;background:#191919;color:#f0eee9;font:12px monospace}.wallet-picker-badge:has(img){background:transparent}.wallet-picker-badge img{display:block;width:36px;height:36px;border-radius:8px;object-fit:contain}.wallet-picker-option>span:nth-child(2){overflow-wrap:anywhere}.wallet-picker-option small{margin-left:auto;flex-shrink:0;font-size:11px;color:#77766f}.wallet-picker-option:has(small):focus-visible,.wallet-picker button:focus-visible{outline:2px solid #fc5d24;outline-offset:3px}.wallet-picker-help{color:#605f59;min-height:44px}.wallet-picker-refresh{min-height:44px;padding:10px 0;border:0;background:transparent;color:inherit;font-size:13px;cursor:pointer}@media(max-width:420px){.wallet-picker{padding:20px}.wallet-picker h2{font-size:30px}.wallet-picker-option{gap:10px;font-size:14px}.wallet-picker-option small{font-size:10px}}@media(forced-colors:active){.wallet-picker button:focus-visible{outline:2px solid Highlight}}

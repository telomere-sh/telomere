HOST_KIT_DIR=/var/lib/telomere-host
HOST_KIT_PORT=13290
HOST_KIT_ISOLATION=gvisor
HOST_KIT_ALLOW_DOCKER_DEVELOPMENT=false
HOST_KIT_DOCKER_SOCKET=/var/run/telomere-hostkit/docker.sock
# Public Ed25519 key of the reviewed control plane, never its private key.
HOST_KIT_CONTROL_KEY=REPLACE_WITH_REVIEWED_PUBLIC_KEY
HOST_KIT_IMAGES_FILE=/etc/telomere-host/images.json
